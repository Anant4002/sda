# SDA Platform Environment Configuration Template
# Copy this file to .env and fill in values. Do not commit .env.

# Database
DB_NAME=Satellite
DB_USER=postgres

DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5434

# Server
PORT=3000

# API Protection
API_KEY=
SYNC_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Cache & Connection Pooling
SATELLITE_CACHE_TTL_MS=300000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Space-Track.org Credentials
# Register at https://www.space-track.org to obtain credentials.
SPACETRACK_USERNAME=your_spacetrack_username_here
SPACETRACK_PASSWORD=your_spacetrack_password_here
SPACETRACK_DEBRIS_URL=https://www.space-track.org/basicspacedata/query/class/gp/OBJECT_TYPE/ROCKET%20BODY/format/tle
SPACETRACK_ROCKET_BODIES_URL=https://www.space-track.org/basicspacedata/query/class/gp/OBJECT_TYPE/DEBRIS/format/tle
